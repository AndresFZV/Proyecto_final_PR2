<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<?import javafx.scene.layout.GridPane?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/22" fx:controller="co.edu.uniquindio.marketplace.marketplace.viewcontroller.MuroViewController">


    <BorderPane prefWidth="800.0" prefHeight="600.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0">


        <center>
            <ScrollPane fx:id="scrollPaneProductos" prefHeight="600.0" prefWidth="600.0">
                <content>
                    <GridPane fx:id="gridPaneProductos" hgap="20" vgap="20" style="-fx-background-color: #f5f5f5;" />
                </content>
            </ScrollPane>
        </center>


        <right>
            <VBox spacing="20.0" prefWidth="200.0" style="-fx-background-color: #f1f1f1; -fx-padding: 15px; -fx-border-radius: 10px; -fx-border-color: #ddd; -fx-border-width: 1px;">

                <Text text="Solicitudes de Amistad" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>


                <ListView fx:id="solicitudesPendientesListView" prefHeight="250.0" style="-fx-background-color: #ffffff;" />


                <HBox spacing="10.0" alignment="CENTER">
                    <Button fx:id="aceptarSolicitudBtn" text="Aceptar" onAction="#aceptarSolicitudAmistad" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                    <Button fx:id="rechazarSolicitudBtn" text="Rechazar" onAction="#rechazarSolicitudAmistad" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
                </HBox>


                <VBox spacing="15.0" style="-fx-padding-top: 20px;">
                    <TextField fx:id="buscarVendedorField" prefWidth="180.0" promptText="Buscar vendedor..." onKeyReleased="#buscarVendedores"/>
                    <ListView fx:id="listaVendedores" prefHeight="150.0" style="-fx-background-color: #ffffff;" />
                    <Button fx:id="enviarSolicitudBtn" text="Enviar solicitud" onAction="#enviarSolicitudAmistad" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                </VBox>
            </VBox>
        </right>
    </BorderPane>

</AnchorPane>
